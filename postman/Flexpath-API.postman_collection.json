          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/parts?search={{search}}&category={{category}}&brand={{brand}}&maxPrice={{maxPrice}}&sortBy={{partSortBy}}&direction={{sortDirection}}&page={{page}}&size={{size}}",
            "description": "Current paginated Parts search. Supported sortBy values: name, price, created_at, category, brand."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Parts page returned', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Response uses PageResult contract', function () {",
                  "  pm.expect(json).to.be.an('object');",
                  "  pm.expect(json.content).to.be.an('array');",
                  "  pm.expect(json).to.have.property('page');",
                  "  pm.expect(json).to.have.property('size');",
                  "  pm.expect(json).to.have.property('totalElements');",
                  "  pm.expect(json).to.have.property('totalPages');",
                  "});"
